{
	"name": "devlife-simulator",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "electron-dist/main.js",
	"author": "DevLife Studio",
	"description": "The Architect: Source Code of a Life - A narrative-driven game about a Vietnamese developer's journey",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"build:web": "tsc && vite build",
		"build:all": "bash scripts/build-all.sh",
		"preview": "vite preview",
		"electron:compile": "tsc -p tsconfig.electron.json",
		"electron:dev": "concurrently \"vite\" \"wait-on http://localhost:2004 && electron .\"",
		"electron:build": "bun run build:web && bun run electron:compile",
		"electron:build:mac": "bun run electron:build && electron-builder --mac",
		"electron:build:win": "bun run electron:build && electron-builder --win",
		"ios": "cap sync ios && cap open ios",
		"android": "cap sync android && cap open android",
		"cap:init:ios": "cap add ios",
		"cap:init:android": "cap add android"
	},
	"dependencies": {
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-router-dom": "^6.20.0",
		"zustand": "^4.4.0",
		"framer-motion": "^10.16.0",
		"howler": "^2.2.3",
		"localforage": "^1.10.0",
		"react-i18next": "^13.5.0",
		"i18next": "^23.7.0"
	},
	"devDependencies": {
		"@capacitor/android": "^5.5.0",
		"@capacitor/cli": "^5.5.0",
		"@capacitor/core": "^5.5.0",
		"@capacitor/filesystem": "^5.1.0",
		"@capacitor/ios": "^5.5.0",
		"@types/howler": "^2.2.11",
		"@types/node": "^20.0.0",
		"@types/react": "^18.2.0",
		"@types/react-dom": "^18.2.0",
		"@vitejs/plugin-react": "^4.2.0",
		"autoprefixer": "^10.4.0",
		"concurrently": "^8.2.0",
		"electron": "^27.0.0",
		"electron-builder": "^24.6.0",
		"postcss": "^8.4.0",
		"tailwindcss": "^3.3.0",
		"typescript": "^5.2.0",
		"vite": "^5.0.0",
		"wait-on": "^9.0.3"
	}
}
